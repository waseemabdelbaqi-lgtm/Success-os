# =============================================================================
# Success OS — Enterprise AI Operating System (AIOS) credentials
# Copy values into `.env.local` (never commit secrets).
# AIOS auto-detects whichever keys are present. Never hardcode secrets.
# =============================================================================

# --- OpenAI (GPT Engineering Agent) ---
OPENAI_API_KEY=
OPENAI_CONTENT_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini

# --- Anthropic Claude (Curriculum Agent) ---
ANTHROPIC_API_KEY=
CLAUDE_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Google Gemini (Research Agent) ---
# Leave empty until intentionally enabled. Existing GEMINI_DISABLED=true is respected.
GEMINI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# MASTER_ORCHESTRATOR_ALLOW_GEMINI=false

# --- GitHub ---
GITHUB_TOKEN=
GH_TOKEN=
GITHUB_REPOSITORY=

# --- Playwright / Testing Agent ---
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
PLAYWRIGHT_BROWSERS_PATH=

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- PostgreSQL ---
DATABASE_URL=
POSTGRES_URL=

# --- Optional media agents ---
HEYGEN_API_KEY=
ELEVENLABS_API_KEY=

# --- Orchestrator behaviour ---
MASTER_ORCHESTRATOR_AUTO_COMMIT=false
MASTER_ORCHESTRATOR_AUTO_PUSH=false
MASTER_ORCHESTRATOR_DRY_RUN=true
MASTER_ORCHESTRATOR_MAX_PARALLEL=4
MASTER_ORCHESTRATOR_REGION=auto
