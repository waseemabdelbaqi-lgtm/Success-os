# =============================================================================
# Success OS — Enterprise AI Operating System (AIOS) credentials
# Copy into `.env.local` (never commit secrets). Empty placeholders only.
# Do not invent model names — set the exact model id available to your account.
# =============================================================================

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- Google Gemini (priority: GEMINI_API_KEY → GOOGLE_API_KEY → GOOGLE_GENERATIVE_AI_API_KEY) ---
GEMINI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=
# If legacy GEMINI_DISABLED=true, set key+model (or AIOS_ALLOW_GEMINI=true) to enable AIOS Gemini use.
# GEMINI_DISABLED=true
# AIOS_ALLOW_GEMINI=false

# --- Ollama (optional local fallback) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# --- Role routing (provider ids: openai | anthropic | gemini | ollama | local) ---
AIOS_DEFAULT_PROVIDER=openai
AIOS_ENGINEERING_PROVIDER=openai
AIOS_FRONTEND_PROVIDER=openai
AIOS_BACKEND_PROVIDER=openai
AIOS_DATABASE_PROVIDER=openai
AIOS_SECURITY_PROVIDER=openai
AIOS_CURRICULUM_PROVIDER=anthropic
AIOS_DOCUMENTATION_PROVIDER=anthropic
AIOS_RESEARCH_PROVIDER=gemini
AIOS_VERIFICATION_PROVIDER=gemini
AIOS_MULTIMODAL_PROVIDER=gemini
AIOS_TESTING_PROVIDER=local
AIOS_FALLBACK_PROVIDER=ollama

# --- Runtime guards ---
AIOS_MAX_PARALLEL_TASKS=4
AIOS_REQUEST_TIMEOUT_MS=180000
AIOS_MAX_RETRIES=3
AIOS_AUTO_COMMIT=false
AIOS_EXECUTION_MODE=review
AIOS_COST_LIMIT_ENABLED=true
AIOS_MAX_TASK_COST_USD=5
AIOS_MAX_DAILY_COST_USD=20
# Optional pricing JSON for estimates; without it cost remains UNKNOWN
# AIOS_PROVIDER_PRICING_JSON={"openai":{"inputPer1k":0,"outputPer1k":0}}

# --- Legacy orchestrator flags (kept; AIOS_AUTO_COMMIT takes precedence for AIOS) ---
MASTER_ORCHESTRATOR_AUTO_COMMIT=false
MASTER_ORCHESTRATOR_AUTO_PUSH=false
MASTER_ORCHESTRATOR_DRY_RUN=true
MASTER_ORCHESTRATOR_MAX_PARALLEL=4

# --- Education Factory (optional) ---
WOLFRAM_APP_ID=

# --- Media Factory (optional; never auto-fired) ---
HEYGEN_API_KEY=
ELEVENLABS_API_KEY=
BLENDER_BIN=

# --- Infrastructure spine (optional; Vercel never auto-deployed by AIOS) ---
GITHUB_TOKEN=
GH_TOKEN=
GITHUB_REPOSITORY=
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
POSTGRES_URL=
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
SENTRY_DSN=
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
