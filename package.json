    "media:g1-sara": "AI_TEACHER_ID=sara python3 scripts/render-g1-colorful-board-lesson.py",
    "media:g1-ali": "AI_TEACHER_ID=ali python3 scripts/render-g1-colorful-board-lesson.py",
    "media:flagship-sara": "AI_TEACHER_ID=sara python3 scripts/render-flagship-ai-teacher-lesson.py",
    "media:flagship-ali": "AI_TEACHER_ID=ali python3 scripts/render-flagship-ai-teacher-lesson.py",
    "validate:education-intelligence-core": "node scripts/education-intelligence-core.test.mjs",
    "export:jordan-curriculum": "node scripts/export-jordan-curriculum-bundle.mjs",
    "media:g1-math-reel": "python3 scripts/render-g1-math-avatar-reel.py",
    "media:g1-math-lesson": "python3 scripts/render-g1-math-est-style-lesson.py",
    "media:g1-colorful-board": "python3 scripts/render-g1-colorful-board-lesson.py",
    "media:heygen-g1-teacher": "python3 scripts/generate-heygen-g1-teacher.py",
    "media:compose-heygen-g1": "python3 scripts/compose-heygen-board-lesson.py",
