    "validate:master-directive": "node scripts/validate-master-directive.mjs",
    "validate:knowledge": "node scripts/validate-knowledge-engine.mjs",
    "knowledge:status": "node scripts/run-global-knowledge-engine.mjs --status",
    "knowledge:queue": "node scripts/run-global-knowledge-engine.mjs --queue",
    "knowledge:run": "node scripts/run-global-knowledge-engine.mjs",
    "quality:status": "node scripts/run-global-quality-engine.mjs --status",
    "quality:run": "node scripts/run-global-quality-engine.mjs",
    "research:me": "node scripts/run-middle-east-research.mjs",
    "research:me:status": "node scripts/run-middle-east-research.mjs --status",
    "map:me": "node scripts/run-middle-east-mapping.mjs",
    "map:me:status": "node scripts/run-middle-east-mapping.mjs --status",
    "factory:validate": "node scripts/run-digital-book-factory.mjs",
    "factory:status": "node scripts/run-digital-book-factory.mjs --status",
    "factory:shell": "node scripts/run-digital-book-factory.mjs --shell-preview",
    "qa:validate": "node scripts/run-success-os-qa-engine.mjs",
    "qa:status": "node scripts/run-success-os-qa-engine.mjs --status",
    "qa:sample": "node scripts/run-success-os-qa-engine.mjs --sample=3",
    "content:validate": "node scripts/run-educational-content-engine.mjs",
    "content:status": "node scripts/run-educational-content-engine.mjs --status",
    "content:sample": "node scripts/run-educational-content-engine.mjs --sample",
    "me:expand": "node scripts/run-middle-east-expansion.mjs",
    "me:expand:status": "node scripts/run-middle-east-expansion.mjs --status",
    "me:dashboard": "node scripts/run-middle-east-expansion.mjs --dashboard",
    "me:audit": "node scripts/run-middle-east-master-audit.mjs",
    "me:audit:no-repair": "node scripts/run-middle-east-master-audit.mjs --no-repair",
    "me:production": "node scripts/run-middle-east-production-readiness.mjs",
    "me:extract": "node scripts/run-middle-east-curriculum-extraction.mjs",
    "me:extract:status": "node scripts/run-middle-east-curriculum-extraction.mjs",
    "me:populate": "node scripts/run-middle-east-content-population.mjs",
    "me:populate:dashboard": "node scripts/run-middle-east-content-population.mjs --dashboard",
    "jo:knowledge": "node scripts/run-jordan-national-knowledge.mjs",
    "jo:knowledge:status": "node scripts/run-jordan-national-knowledge.mjs --status",
    "jo:knowledge:dashboard": "node scripts/run-jordan-national-knowledge.mjs --dashboard",
    "jo:knowledge:harvest": "node scripts/run-jordan-national-knowledge.mjs --harvest-nccd",
    "jo:install-curriculum": "node scripts/install-jordan-curriculum.mjs",
    "jo:produce": "node scripts/run-jordan-book-production.mjs",
    "jo:produce:next": "node scripts/run-jordan-book-production.mjs --next",
    "jo:produce:math": "node scripts/run-jordan-book-production.mjs --subject=الرياضيات",
    "jo:produce:dashboard": "node scripts/run-jordan-book-production.mjs --dashboard",
    "jo:verify": "node scripts/run-jordan-curriculum-verification.mjs",
    "jo:verify:dashboard": "node scripts/run-jordan-curriculum-verification.mjs --dashboard",
    "jo:references": "node scripts/run-jordan-reference-library.mjs",
    "jo:references:dashboard": "node scripts/run-jordan-reference-library.mjs --dashboard",
    "jo:references:link": "node scripts/run-jordan-reference-library.mjs --link",
    "jo:update": "node scripts/run-jordan-curriculum-update.mjs",
    "jo:update:dashboard": "node scripts/run-jordan-curriculum-update.mjs --dashboard",
    "jo:paths": "node scripts/run-jordan-learning-path.mjs",
    "jo:paths:dashboard": "node scripts/run-jordan-learning-path.mjs --dashboard",
    "jo:normalize": "node scripts/run-jordan-curriculum-normalization.mjs",
    "jo:normalize:dashboard": "node scripts/run-jordan-curriculum-normalization.mjs --dashboard",
    "jo:factory": "node scripts/run-jordan-content-factory.mjs",
    "jo:factory:dashboard": "node scripts/run-jordan-content-factory.mjs --dashboard",
    "jo:factory:queue": "node scripts/run-jordan-content-factory.mjs --queue",
    "jo:registry": "node scripts/run-jordan-national-education-registry.mjs",
    "jo:registry:dashboard": "node scripts/run-jordan-national-education-registry.mjs --dashboard",
    "jo:g1": "node scripts/run-jordan-grade1-learning-ecosystem.mjs",
    "jo:g1:dashboard": "node scripts/run-jordan-grade1-learning-ecosystem.mjs --dashboard",
    "jo:g1:math": "node scripts/run-jordan-grade1-learning-ecosystem.mjs --subject=الرياضيات",
    "jo:kg": "node scripts/run-jordan-grade1-knowledge-graph.mjs",
    "jo:kg:dashboard": "node scripts/run-jordan-grade1-knowledge-graph.mjs --dashboard",
    "validate:global-knowledge": "node scripts/validate-global-knowledge-engine.mjs",
    "validate:global-quality": "node scripts/validate-global-quality-engine.mjs",
    "validate:all": "npm run validate:links && npm run validate:journey && npm run validate:content && npm run validate:curricula && npm run validate:ai && npm run validate:books && npm run validate:jordan && npm run validate:generated-books && npm run validate:master-directive && npm run validate:knowledge && npm run validate:global-knowledge && npm run validate:global-quality",
    "protect:manifest": "node scripts/content-protection-manifest.mjs",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build && node scripts/copy-hosting.mjs",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.7.0",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "clsx": "^2.1.1",
    "firebase": "^11.6.0",
    "firebase-admin": "^13.2.0",
    "framer-motion": "^12.23.6",
    "katex": "^0.18.1",
    "mermaid": "^11.16.0",
    "next": "^15.3.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.2.0",
    "three": "^0.185.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.44.0",
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.4",
    "@types/node": "^22.14.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vinext/cloudflare": "0.2.1",
    "@vitejs/plugin-react": "latest",
    "@vitejs/plugin-rsc": "^0.5.27",
    "eslint": "^9.24.0",
    "eslint-config-next": "^15.3.0",
    "eslint-config-prettier": "^10.1.2",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "react-server-dom-webpack": "^19.2.7",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3",
    "vinext": "0.2.1",
    "vite": "latest",
    "wrangler": "^4.110.0"
  }
}
