    "validate:ai-teachers": "node scripts/validate-ai-teachers.mjs",
    "validate:digital-human-studio": "node scripts/digital-human-studio.test.mjs",
    "validate:human-engine": "node scripts/human-engine.test.mjs",
    "validate:human-teacher-engine": "node scripts/human-teacher-engine.test.mjs",
