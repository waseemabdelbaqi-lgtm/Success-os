# =============================================================================
# Success OS — Environment Variables
# =============================================================================
# Copy this file to `.env.local` for local development.
# Never commit `.env.local` or any file containing secrets.
#
# Public variables (NEXT_PUBLIC_*) are exposed to the browser.
# Server-only variables must never use the NEXT_PUBLIC_ prefix.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Success OS
# Canonical site origin used for Stripe success/cancel redirects (and similar).
# Prefer this over request.origin when developing behind proxies/tunnels.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Legacy alias — still read as a fallback if SITE_URL is unset.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# -----------------------------------------------------------------------------
# Firebase — Client (Public)
# Get these from Firebase Console → Project Settings → Your apps → Web app
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# -----------------------------------------------------------------------------
# Firebase — Admin SDK (Server Only — NEVER expose to client)
# Generate from Firebase Console → Project Settings → Service Accounts
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
AUTH_SESSION_COOKIE_NAME=__session
AUTH_SESSION_COOKIE_MAX_AGE=432000
AUTH_SESSION_META_SECRET=change-me-to-a-random-32-char-secret
AUTH_SECURE_COOKIES=false

# -----------------------------------------------------------------------------
# OAuth Providers
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APPLE_SIGNIN_ENABLED=false

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
# Keep false for local preview of SUCCESS-OS public journeys without Firebase.
# Set true only when Firebase client + admin credentials are configured.
FEATURE_AUTH_ENABLED=false
NEXT_PUBLIC_FEATURE_AUTH_ENABLED=false
FEATURE_ANALYTICS_ENABLED=false

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Admission funnel — $5 Apply Now payment + official email (Route B)
# -----------------------------------------------------------------------------
# Supabase (optional). Without these, the funnel uses an in-memory preview store
# and the seeded fallback institution catalogue.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (optional). Without these keys, checkout runs in secure preview mode.
# Dashboard → Developers → API keys (test mode):
#   STRIPE_SECRET_KEY=sk_test_...
# Webhook endpoint (local: stripe listen --forward-to localhost:3000/api/webhook/stripe):
#   STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Live admission criteria (optional). Without these, mock Arabic criteria is used.
# Tavily: https://tavily.com — web search for official university requirements
TAVILY_API_KEY=
# OpenAI: gpt-4o-mini extracts min GPA + Arabic requirements summary
OPENAI_API_KEY=
OPENAI_ADMISSION_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Gemini — script + image rebuild for elementary AI assistant teacher
# https://aistudio.google.com/apikey
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# -----------------------------------------------------------------------------
# Elementary AI Teacher Studio (REAL moving teacher — required for product ceiling)
# Preview slides/TTS are NOT enough. Wire one avatar provider:
# -----------------------------------------------------------------------------
# HeyGen (recommended): https://www.heygen.com/
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=
# Synthesia (alternative): https://www.synthesia.io/
SYNTHESIA_API_KEY=
SYNTHESIA_AVATAR_ID=
SYNTHESIA_BACKGROUND=green_screen
# Optional premium voice upgrade
ELEVENLABS_API_KEY=

# Email for non-partner institutions (optional). Without keys, HTML is composed
# and returned to the student for mailto / manual send.
RESEND_API_KEY=
SMTP_URL=
EMAIL_FROM=SUCCESS OS <admissions@successos.app>

# Interactive lesson voice upgrade (optional, paid)
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID_AR=
# ELEVENLABS_VOICE_ID_EN=
