# =============================================================================
# Success OS — Environment Variables
# =============================================================================
# Copy this file to `.env.local` for local development.
# Never commit `.env.local` or any file containing secrets.
#
# Public variables (NEXT_PUBLIC_*) are exposed to the browser.
# Server-only variables must never use the NEXT_PUBLIC_ prefix.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Success OS
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# -----------------------------------------------------------------------------
# Firebase — Client (Public)
# Get these from Firebase Console → Project Settings → Your apps → Web app
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# -----------------------------------------------------------------------------
# Firebase — Admin SDK (Server Only — NEVER expose to client)
# Generate from Firebase Console → Project Settings → Service Accounts
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
AUTH_SESSION_COOKIE_NAME=__session
AUTH_SESSION_COOKIE_MAX_AGE=432000
AUTH_SESSION_META_SECRET=change-me-to-a-random-32-char-secret
AUTH_SECURE_COOKIES=false

# -----------------------------------------------------------------------------
# OAuth Providers
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APPLE_SIGNIN_ENABLED=false

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
# Keep false for local preview of SUCCESS-OS public journeys without Firebase.
# Set true only when Firebase client + admin credentials are configured.
FEATURE_AUTH_ENABLED=false
NEXT_PUBLIC_FEATURE_AUTH_ENABLED=false
FEATURE_ANALYTICS_ENABLED=false

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=info

# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# AIOS / SUCCESS AI OS — provider activation (optional; never commit secrets)
# Full checklist: enterprise-ai/docs/PROVIDER_ACTIVATION_CHECKLIST.md
# READY path: config detected → auth probe → capability probe → persisted evidence → dashboard
# Probe: npm run ai:aios:health -- --provider=<id> --mode=live
# -----------------------------------------------------------------------------

# --- Playwright (infrastructure #1) — no API key; local Chromium only ---
# Required: none (package + Chromium install)
# Optional: PLAYWRIGHT_BASE_URL (default http://localhost:3000), PLAYWRIGHT_ALLOW_REMOTE=false
# Probe: npm run ai:aios:health -- --provider=playwright --mode=live
# READY evidence: packageVersion, browserVersion, liveProbe PASSED, latencyMs, targetType=LOCAL
# Destructive: no | Approval: no | Cost: none
PLAYWRIGHT_BASE_URL=http://localhost:3000
PLAYWRIGHT_ALLOW_REMOTE=false
# PLAYWRIGHT_PROBE_TIMEOUT_MS=30000
# PLAYWRIGHT_START_SERVER=false

# --- Supabase (infrastructure #2) ---
# Required: SUPABASE_URL + (SUPABASE_ANON_KEY or SUPABASE_SERVICE_ROLE_KEY)
# Optional: NEXT_PUBLIC_SUPABASE_* (public anon only)
# Probe: --provider=supabase --mode=live
# READY evidence: authorised health/read success, latencyMs
# Destructive: no (read-only) | Approval: no for health | Cost: none
# SUPABASE_SERVICE_ROLE_KEY is server-only — never NEXT_PUBLIC_
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- GitHub (infrastructure #3) ---
# Required: GITHUB_TOKEN or GH_TOKEN
# Optional: GITHUB_REPOSITORY
# Probe: --provider=github --mode=live
# READY evidence: authenticated /user read
# Destructive: no (health never creates issues/PRs/commits) | Cost: none
GITHUB_TOKEN=
GH_TOKEN=
GITHUB_REPOSITORY=

# --- OpenAI (coding/education #4) ---
# Required: OPENAI_API_KEY (or OPENAI_CONTENT_API_KEY), OPENAI_MODEL
# Probe: --provider=openai --mode=live
# READY evidence: authenticated minimal text AIOS_OK, model, latencyMs
# Destructive: no | Cost: token usage (minimal) | Approval: no for health
OPENAI_API_KEY=
OPENAI_CONTENT_API_KEY=
OPENAI_MODEL=

# --- Claude / Anthropic (coding/education #5) ---
# Required: ANTHROPIC_API_KEY, ANTHROPIC_MODEL
# Probe: --provider=anthropic --mode=live
# READY evidence: authenticated minimal message, model, latencyMs
# Destructive: no | Cost: token usage (minimal)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- Gemini (education #6) ---
# Required: GEMINI_API_KEY (or GOOGLE_API_KEY), GEMINI_MODEL
# Probe: --provider=gemini --mode=live
# READY evidence: authenticated minimal text, model, latencyMs
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=

# --- Ollama (local coding fallback; currently READY when probed) ---
# Required: OLLAMA_MODEL + reachable OLLAMA_BASE_URL
# Probe: --provider=ollama --mode=live
# READY evidence: local inference AIOS_OK, model, latencyMs
# Destructive: no | Cost: none (local)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# --- Wolfram (education #7) ---
# Required: WOLFRAM_APP_ID
# Probe: --provider=wolfram --mode=live
# READY evidence: lightweight query success
# Destructive: no | Cost: API quota
WOLFRAM_APP_ID=

# --- Browserbase (infrastructure #8) ---
# Required: BROWSERBASE_API_KEY
# Optional: BROWSERBASE_PROJECT_ID
# Probe: --provider=browserbase --mode=live (account/project only; sessions optional)
# Destructive: no for standard health | Cost: possible if session probe enabled
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# --- Sentry (infrastructure #9) ---
# Required for live auth probe: SENTRY_AUTH_TOKEN (DSN alone is not enough for green)
# Optional: SENTRY_DSN, RUN_SENTRY_LIVE_TEST=true (sends tagged test event — approval recommended)
# Probe: --provider=sentry --mode=live
# Destructive: no unless RUN_SENTRY_LIVE_TEST | Cost: none
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
# RUN_SENTRY_LIVE_TEST=false

# --- Vercel (infrastructure #10) — read-only; NEVER_AUTO_DEPLOY ---
# Required: VERCEL_TOKEN
# Optional: VERCEL_PROJECT_ID
# Probe: --provider=vercel --mode=live
# READY evidence: authenticated user/project metadata read
# Destructive: no | Deploy: NEVER via AIOS health
VERCEL_TOKEN=
VERCEL_PROJECT_ID=

# --- ElevenLabs (media #11) — connection probe only; no paid audio ---
# Required: ELEVENLABS_API_KEY
# Probe: --provider=elevenlabs --mode=live
# READY evidence: account/voices capability (CONNECTION_READY); GENERATION_VERIFIED separate + approved
# Destructive: no for standard health | Cost: none for health; audio generation requires approval
ELEVENLABS_API_KEY=

# --- HeyGen (media #12) — connection probe only; no video generation ---
# Required: HEYGEN_API_KEY
# Optional: HEYGEN_PROBE_TIMEOUT_MS=12000
# Probe: --provider=heygen --mode=live
# READY evidence: account/avatars capability; never creates a video in health
# Destructive: no for standard health | Cost: none for health; video requires approval
HEYGEN_API_KEY=
# HEYGEN_PROBE_TIMEOUT_MS=12000

# --- OpenAI Images (media #13) — separate from text OpenAI ---
# Required: same OpenAI key; image permission
# Probe: --provider=openai-images --mode=live (config/capability; no billable image by default)
# READY evidence: image capability verified; GENERATION_VERIFIED requires approval
# Destructive: no for standard health | Cost: image generation requires approval
