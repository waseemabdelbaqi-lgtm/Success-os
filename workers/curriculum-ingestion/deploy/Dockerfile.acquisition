# Jordan acquisition-only worker image (large files / long jobs).
# Region selectable via REGION / AWS_REGION / FLY_REGION env.
FROM node:22-bookworm-slim

WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY workers/curriculum-ingestion ./workers/curriculum-ingestion
COPY scripts/curriculum-ai ./scripts/curriculum-ai

ENV CURRICULUM_STORAGE_BACKEND=local \
    NODE_ENV=production \
    ACQUISITION_REGION=auto

CMD ["node", "workers/curriculum-ingestion/src/index.js", "recovery"]
